
scores = [89, 79, 72, 92, 88]

print("Student Scores:")
for score in scores:
    print(score)

print()

passed = 0
failed = 0

for i, score in enumerate(scores, start=1):

    if score >= 90:
        grade = "Excellent"
    elif score >= 80:
        grade = "Very Good"
    elif score >= 75:
        grade = "Good"
    else:
        grade = "Failed"

    if score >= 75:
        status = "Passed"
        passed += 1
    else:
        status = "Failed"
        failed += 1

    print(f"Student {i}: {score} - {grade} - {status}")

total = sum(scores)
average = total / len(scores)
highest = max(scores)
lowest = min(scores)

print()
print(f"Total Score: {total}")
print(f"Average Score: {average:.0f}")
print(f"Highest Score: {highest}")
print(f"Lowest Score: {lowest}")
print(f"Passed: {passed}")
print(f"Failed: {failed}")
