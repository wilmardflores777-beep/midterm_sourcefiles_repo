
raw_records = [
    "Ana,88,92,90",
    "Ben,70,72,74",
    "Cara,95,91,94",
    "Dan,78,80,76",
    "Ella,85,89,87",
    "Fred,90,85",           
    "Gina",                
    "Henry,90,eighty,85",  
    "Ivy,"                 
]
PASSING_GRADE = 75

student_scores = {}

for record in raw_records:
    fields = record.split(",")

    if len(fields) != 4:
        print(f"Skipped invalid record (incorrect field count): {record}")
        continue

    name = fields[0].strip()

    try:
        scores = [int(score.strip()) for score in fields[1:]]
    except ValueError:
        print(f"Skipped invalid record: {record}")
        continue
    
    student_scores[name] = scores


print("\nORGANIZED STUDENT RECORDS")
for name in sorted(student_scores.keys()):
    print(f"{name}: {student_scores[name]}")


ranking = []

passed_count = 0
failed_count = 0
sum_of_averages = 0

for name, scores in student_scores.items():
    if not scores:
        continue

    total = sum(scores)
    total_scores_count = len(scores)
    average = total / total_scores_count
    highest_score = max(scores)
    lowest_score = min(scores)

    if average >= PASSING_GRADE:
        remark = "Passed"
        passed_count += 1
    else:
        remark = "Failed"
        failed_count += 1

    sum_of_averages += average

    ranking.append((average, name, highest_score, lowest_score, remark))


ranking.sort(reverse=True, key=lambda x: x[0])

print("\nSTUDENT GRADE REPORT")
print(f"{'Rank':<5} {'Name':<6} {'Average':<8} {'Highest':<8} {'Lowest':<8} {'Remark':<6}")

for rank, (average, name, highest_score, lowest_score, remark) in enumerate(ranking, start=1):
    print(f"{rank:<5} {name:<6} {average:<8.2f} {highest_score:<8} {lowest_score:<8} {remark:<6}")


total_valid_students = len(ranking)

class_average = sum_of_averages / total_valid_students if total_valid_students > 0 else 0

print("\nCLASS SUMMARY")
print(f"Number of Students: {total_valid_students}")
print(f"Passed: {passed_count}")
print(f"Failed: {failed_count}")
print(f"Class Average: {class_average:.2f}")

if ranking:
    highest_student = ranking[0]   
    lowest_student = ranking[-1]   
    print(f"Highest: {highest_student[1]} - {highest_student[0]:.2f}")
    print(f"Lowest: {lowest_student[1]} - {lowest_student[0]:.2f}")
