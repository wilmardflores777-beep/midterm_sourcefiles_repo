
def classify_grade(grade):
    if grade >= 90:
        return "Excellent", "Passed"
    elif grade >= 85:
        return "Very Good", "Passed"
    elif grade >= 80:
        return "Good", "Passed"
    elif grade >= 75:
        return "Satisfactory", "Passed"
    else:
        return "Needs Improvement", "Failed"


def load_students(filename):
    students = []
    try:
        with open(filename, "r") as file:
            for line in file:
                cleaned_line = line.strip()
                if not cleaned_line:
                    continue  

                fields = cleaned_line.split(",")
                if len(fields) != 3:
                    continue  

                student_id = fields[0].strip()
                name = fields[1].strip()
                grade_str = fields[2].strip()

                try:
                    grade = float(grade_str)
                    if 0 <= grade <= 100:
                        students.append({
                            "student_id": student_id,
                            "name": name,
                            "grade": grade,
                        })
                except ValueError:
                    continue  
    except FileNotFoundError:
        print(f"Error: The file '{filename}' was not found.")
    except OSError as e:
        print(f"Error reading file '{filename}': {e}")

    return students


def calculate_statistics(students):
    if not students:
        return None

    total_grade = 0.0
    passed_count = 0
    failed_count = 0
    highest_student = students[0]
    lowest_student = students[0]

    for student in students:
        grade = student["grade"]
        total_grade += grade

        _, status = classify_grade(grade)
        if status == "Passed":
            passed_count += 1
        else:
            failed_count += 1

        if grade > highest_student["grade"]:
            highest_student = student
        if grade < lowest_student["grade"]:
            lowest_student = student

    total_students = len(students)
    average_grade = total_grade / total_students if total_students > 0 else 0.0

    return {
        "count": total_students,
        "average": average_grade,
        "passed": passed_count,
        "failed": failed_count,
        "highest": highest_student,
        "lowest": lowest_student,
    }


def display_students(students):
    if not students:
        print("\nNo student records to display.")
        return

    print("\n" + "=" * 65)
    print(f"{'ID':<12} {'Name':<20} {'Grade':<8} {'Classification':<18} {'Status'}")
    print("-" * 65)

    for s in students:
        classification, status = classify_grade(s["grade"])
        truncated_name = s["name"][:18]  
        print(f"{s['student_id']:<12} {truncated_name:<20} {s['grade']:<8.2f} {classification:<18} {status}")

    print("=" * 65)


def display_statistics(statistics):
    if not statistics:
        print("\nNo statistics available.")
        return

    print("\nCLASS STATISTICS")
    print(f"Number of students: {statistics['count']}")
    print(f"Class average: {statistics['average']:.2f}")
    print(f"Passed: {statistics['passed']}")
    print(f"Failed: {statistics['failed']}")

    highest = statistics["highest"]
    lowest = statistics["lowest"]
    if highest:
        print(f"Highest: {highest['name']} - {highest['grade']:.2f}")
    if lowest:
        print(f"Lowest: {lowest['name']} - {lowest['grade']:.2f}")


def search_student(students, keyword):
    matches = []
    clean_keyword = keyword.lower().strip()

    if not clean_keyword:
        return matches

    for student in students:
        if clean_keyword in student["student_id"].lower() or clean_keyword in student["name"].lower():
            matches.append(student)

    return matches


def save_report(students, statistics, filename):
    if not students or not statistics:
        print("\nCannot save report: No student data or statistics available.")
        return

    try:
        with open(filename, "w") as file:
            file.write("===========================================\n")
            file.write("           STUDENT GRADE REPORT            \n")
            file.write("===========================================\n\n")

            file.write("--- ALL STUDENT RECORDS ---\n")
            for s in students:
                classification, status = classify_grade(s["grade"])
                file.write(
                    f"ID: {s['student_id']} | Name: {s['name']} | "
                    f"Grade: {s['grade']:.2f} | Classification: {classification} | Status: {status}\n"
                )

            file.write("\n--- CLASS STATISTICS ---\n")
            file.write(f"Number of students: {statistics['count']}\n")
            file.write(f"Class average: {statistics['average']:.2f}\n")
            file.write(f"Passed: {statistics['passed']}\n")
            file.write(f"Failed: {statistics['failed']}\n")

            highest = statistics["highest"]
            lowest = statistics["lowest"]
            if highest:
                file.write(f"Highest: {highest['name']} - {highest['grade']:.2f}\n")
            if lowest:
                file.write(f"Lowest: {lowest['name']} - {lowest['grade']:.2f}\n")

            file.write("===========================================\n")

        print(f"\nReport successfully saved to '{filename}'.")
    except OSError as e:
        print(f"\nError saving report to '{filename}': {e}")


def main():
    students = load_students("grades.txt")

    if not students:
        print("No valid student records were loaded.")
        return

    statistics = calculate_statistics(students)

    while True:
        print("\nSTUDENT GRADE ANALYZER")
        print("[1] Display all students")
        print("[2] Display class statistics")
        print("[3] Search for a student")
        print("[4] Save report")
        print("[5] Exit")

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            display_students(students)

        elif choice == "2":
            display_statistics(statistics)

        elif choice == "3":
            keyword = input("Enter student ID or name keyword: ")
            results = search_student(students, keyword)
            if results:
                print(f"\nFound {len(results)} matching record(s):")
                display_students(results)
            else:
                print("\nNo matching student records found.")

        elif choice == "4":
            save_report(students, statistics, "grade_report.txt")

        elif choice == "5":
            print("\nExiting Student Grade Analyzer. Goodbye!")
            break

        else:
            print("\nInvalid choice. Please select a valid option (1-5).")
            continue


if __name__ == "__main__":
    main()
